# Porta em que a API vai rodar
PORT=3000

# Origem permitida no CORS (endereço do frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:9000

# Chave que assina os tokens JWT de login. Troque por uma string longa e
# aleatória (ex.: `openssl rand -hex 32`). Se vazar, qualquer um consegue
# forjar um login — nunca comite o .env de verdade.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Conexão com o PostgreSQL (base própria do falcon-proteses — criada vazia
# e montada com `npm run db:migrar`, ver README).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=falcon_proteses

# Fuso horário do negócio (sessão do Postgres + processo Node). Padrão
# America/Sao_Paulo (Brasília). Clientes em outro fuso: ex. America/Manaus.
# APP_TZ=America/Sao_Paulo
